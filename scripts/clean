#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="${FINETUNE_SCRIPT_ROOT:-$(cd -- "$(dirname -- "$0")" && pwd)}"
source "$SCRIPT_DIR/lib/common.sh"

rm -rf "$REPO_ROOT/.build" "$REPO_ROOT/DerivedData" "$REPO_ROOT/result" "$REPO_ROOT/dist"
info "removed generated .build, DerivedData, result, and dist output"

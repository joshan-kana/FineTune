#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="${FINETUNE_SCRIPT_ROOT:-$(cd -- "$(dirname -- "$0")" && pwd)}"
source "$SCRIPT_DIR/lib/common.sh"
source "$SCRIPT_DIR/lib/xcode.sh"

ensure_repo
require_full_xcode
"$SCRIPT_DIR/doctor"
FINETUNE_CONFIGURATION=Release "$SCRIPT_DIR/build"
"$SCRIPT_DIR/test"

source_app="$PRODUCTS_ROOT/Release/FineTune.app"
target_app="/Applications/FineTune.app"
timestamp="$(date +%Y%m%d-%H%M%S)"
rollback_root="$HOME/Library/Application Support/FineTune/Backups/$timestamp"
mkdir -p "$rollback_root"

if [[ -d "$target_app" ]]; then
    ditto "$target_app" "$rollback_root/FineTune.app"
    codesign --verify --deep --strict "$rollback_root/FineTune.app"
    info "rollback backup: $rollback_root/FineTune.app"
fi

osascript -e 'tell application "FineTune" to quit' >/dev/null 2>&1 || true
install_tmp="$(mktemp -d "$BUILD_ROOT/install.XXXXXX")"
trap 'rm -rf "$install_tmp"' EXIT
ditto "$source_app" "$install_tmp/FineTune.app"
codesign --force --deep --sign - "$install_tmp/FineTune.app"
codesign --verify --deep --strict "$install_tmp/FineTune.app"
if [[ -d "$target_app" ]]; then rm -rf "$target_app"; fi
ditto "$install_tmp/FineTune.app" "$target_app"
if ! codesign --verify --deep --strict "$target_app"; then
    rm -rf "$target_app"
    [[ -d "$rollback_root/FineTune.app" ]] && ditto "$rollback_root/FineTune.app" "$target_app"
    die "installation validation failed; previous app restored"
fi
bundle_id="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$target_app/Contents/Info.plist")"
[[ "$bundle_id" == "com.joshankana.FineTune" ]] || warn "bundle identifier is $bundle_id; fork identity migration is pending"
open "$target_app"
info "installed and launched: $target_app"
info "grant Screen & System Audio Recording permission to the fork build if macOS prompts"
